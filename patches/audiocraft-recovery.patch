@@ -481,0 +554,87 @@ class MusicGenSolver(base.StandardSolver):
+    def _completed_updates(self, batch_index: int) -> int:
+        completed_updates = max(self.epoch - 1, 0) * self.train_updates_per_epoch
+        if self.is_training:
+            completed_updates += batch_index // self.gradient_accumulation_steps
+        else:
+            completed_updates += self.train_updates_per_epoch
+        return completed_updates
+
+    @staticmethod
+    def _scheduled_recovery_ratio(
+        target_ratio: float,
+        start_update: int,
+        ramp_updates: int,
+        completed_updates: int,
+    ) -> float:
+        """Ramp the share of recovery microbatches by optimizer update."""
+        if completed_updates < start_update:
+            return 0.0
+        if ramp_updates == 0:
+            return target_ratio
+        elapsed_updates = completed_updates - start_update + 1
+        progress = min(max(elapsed_updates / ramp_updates, 0.0), 1.0)
+        return target_ratio * progress
+
+    @staticmethod
+    def _deterministic_recovery_choice(
+        ratio: float,
+        global_batch_index: int,
+        seed: int,
+    ) -> bool:
+        """Choose recovery batches identically on every distributed rank."""
+        if ratio <= 0:
+            return False
+        if ratio >= 1:
+            return True
+        value = (global_batch_index + seed + 0x9E3779B9) & 0xFFFFFFFF
+        value = ((value ^ (value >> 16)) * 0x21F0AAAD) & 0xFFFFFFFF
+        value = ((value ^ (value >> 15)) * 0x735A2D97) & 0xFFFFFFFF
+        value = (value ^ (value >> 15)) & 0xFFFFFFFF
+        return value < int(ratio * (1 << 32))
+
+    def _recovery_batch_state(self, batch_index: int) -> tp.Tuple[bool, float]:
+        recovery_cfg = self.cfg.distillation.recovery
+        if not self.is_training or not bool(recovery_cfg.enabled):
+            return False, 0.0
+        ratio = self._scheduled_recovery_ratio(
+            float(recovery_cfg.ratio),
+            int(recovery_cfg.start_update),
+            int(recovery_cfg.ramp_updates),
+            self._completed_updates(batch_index),
+        )
+        global_batch_index = (
+            max(self.epoch - 1, 0) * self.train_batches_per_epoch
+            + batch_index
+        )
+        use_recovery = self._deterministic_recovery_choice(
+            ratio, global_batch_index, int(self.cfg.seed))
+        return use_recovery, ratio
+
+    @staticmethod
+    def _mask_recovery_prefix(
+        mask: torch.Tensor,
+        prefix_tokens: int,
+    ) -> torch.Tensor:
+        if prefix_tokens <= 0 or prefix_tokens >= mask.shape[-1]:
+            raise ValueError(
+                "Recovery prefix must leave at least one token for KL training."
+            )
+        recovery_mask = mask.clone()
+        recovery_mask[..., :prefix_tokens] = False
+        return recovery_mask
+
+    @staticmethod
+    def _distillation_objective(
+        kd: torch.Tensor,
+        ce: tp.Optional[torch.Tensor],
+        kd_weight: float,
+        ce_weight: float,
+        recovery_batch: bool,
+    ) -> tp.Tuple[torch.Tensor, float]:
+        """Combine normal losses or route recovery batches to KL only."""
+        if recovery_batch:
+            return kd_weight * kd, 0.0
+        if ce is None:
+            raise ValueError("Normal distillation requires cross entropy.")
+        return kd_weight * kd + ce_weight * ce, ce_weight
+

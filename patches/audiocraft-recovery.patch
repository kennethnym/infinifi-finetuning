+    def _prepare_recovery_tokens_and_attributes(
+        self,
+        batch: tp.Tuple[torch.Tensor, tp.List[SegmentWithAttributes]],
+    ) -> tp.Tuple[dict, torch.Tensor, torch.Tensor]:
+        """Sample student rollouts and mask KL to the post-prefix span."""
+        attributes = self._distillation_attributes(batch)

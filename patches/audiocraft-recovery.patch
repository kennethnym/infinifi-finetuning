diff --git a/tests/solvers/test_musicgen_distillation.py b/tests/solvers/test_musicgen_distillation.py
index 67d6a2e..2218f63 100644
--- a/tests/solvers/test_musicgen_distillation.py
+++ b/tests/solvers/test_musicgen_distillation.py
@@ -0,0 +1 @@
+from contextlib import nullcontext
@@ -81,0 +83,111 @@ def test_zero_length_distillation_schedule_uses_final_weights():
+def test_recovery_ratio_starts_then_ramps_by_optimizer_update():
+    scheduled = MusicGenSolver._scheduled_recovery_ratio
+
+    assert scheduled(0.05, 100, 20, 99) == 0.0
+    assert scheduled(0.05, 100, 20, 100) == pytest.approx(0.0025)
+    assert scheduled(0.05, 100, 20, 109) == pytest.approx(0.025)
+    assert scheduled(0.05, 100, 20, 119) == pytest.approx(0.05)
+    assert scheduled(0.05, 100, 0, 100) == pytest.approx(0.05)
+
+
+def test_recovery_choice_is_deterministic_and_tracks_target_ratio():
+    choices = [
+        MusicGenSolver._deterministic_recovery_choice(0.05, index, 2036)
+        for index in range(10_000)
+    ]
+
+    assert choices == [
+        MusicGenSolver._deterministic_recovery_choice(0.05, index, 2036)
+        for index in range(10_000)
+    ]
+    assert sum(choices) / len(choices) == pytest.approx(0.05, abs=0.002)
+
+
+def test_recovery_mask_excludes_student_prefix_without_mutating_input():
+    mask = torch.ones((2, 4, 6), dtype=torch.bool)
+
+    recovery_mask = MusicGenSolver._mask_recovery_prefix(mask, 4)
+
+    assert mask.all()
+    assert not recovery_mask[..., :4].any()
+    assert recovery_mask[..., 4:].all()
+
+
+def test_recovery_objective_uses_teacher_kl_only():
+    kd = torch.tensor(2.0, requires_grad=True)
+
+    loss, ce_weight = MusicGenSolver._distillation_objective(
+        kd, None, 0.75, 0.25, recovery_batch=True)
+    loss.backward()
+
+    assert loss.item() == pytest.approx(1.5)
+    assert ce_weight == 0.0
+    assert kd.grad.item() == pytest.approx(0.75)
+
+
+def test_normal_objective_keeps_ce_and_teacher_kl():
+    kd = torch.tensor(2.0)
+    ce = torch.tensor(4.0)
+
+    loss, ce_weight = MusicGenSolver._distillation_objective(
+        kd, ce, 0.75, 0.25, recovery_batch=False)
+
+    assert loss.item() == pytest.approx(2.5)
+    assert ce_weight == pytest.approx(0.25)
+
+
+def test_recovery_rollout_restores_training_mode_and_masks_prefix():
+    class ConditionProvider:
+        def tokenize(self, attributes):
+            return attributes
+
+        def __call__(self, tokenized):
+            return {"description": tokenized}
+
+    class Model:
+        def __init__(self):
+            self.training = True
+            self.condition_provider = ConditionProvider()
+            self.generate_kwargs = None
+
+        def eval(self):
+            self.training = False
+
+        def train(self, mode=True):
+            self.training = mode
+
+        def generate(self, **kwargs):
+            assert not self.training
+            self.generate_kwargs = kwargs
+            return torch.zeros((1, 4, kwargs["max_gen_len"]), dtype=torch.long)
+
+    instance = object.__new__(MusicGenSolver)
+    instance.model = Model()
+    instance.compression_model = SimpleNamespace(frame_rate=5)
+    instance.autocast = nullcontext()
+    instance.cfg = SimpleNamespace(
+        distillation=SimpleNamespace(
+            recovery=SimpleNamespace(
+                prefix_duration=2.0,
+                loss_duration=1.0,
+                sampling_temperature=0.9,
+                top_k=50,
+                top_p=0.0,
+                cfg_coef=3.0,
+            )
+        )
+    )
+    instance._distillation_attributes = lambda batch: ["prompt"]
+
+    conditions, tokens, mask = instance._prepare_recovery_tokens_and_attributes(
+        (torch.empty(1), []))
+
+    assert instance.model.training
+    assert instance.model.generate_kwargs["max_gen_len"] == 15
+    assert instance.model.generate_kwargs["top_k"] == 50
+    assert conditions == {"description": ["prompt"]}
+    assert tokens.shape == (1, 4, 15)
+    assert not mask[..., :10].any()
+    assert mask[..., 10:].all()
+
+

@@ -0,0 +1,87 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from audiocraft.solvers.musicgen import MusicGenSolver
+
+
+def solver(temperature=2.0):
+    return SimpleNamespace(
+        cfg=SimpleNamespace(
+            distillation=SimpleNamespace(temperature=temperature)
+        )
+    )
+
+
+def test_distillation_kl_is_zero_for_identical_logits():
+    logits = torch.tensor([
+        [
+            [[2.0, 1.0, -1.0], [0.5, 0.0, -0.5]],
+            [[1.0, 0.0, -1.0], [3.0, 2.0, 1.0]],
+        ],
+    ])
+    mask = torch.ones(logits.shape[:-1], dtype=torch.bool)
+
+    kd, per_codebook = MusicGenSolver._compute_distillation_kl(
+        solver(), logits, logits.clone(), mask)
+
+    assert kd.item() == pytest.approx(0.0, abs=1e-6)
+    assert len(per_codebook) == 2
+
+
+def test_distillation_kl_ignores_masked_positions_and_backpropagates():
+    teacher = torch.tensor([
+        [
+            [[3.0, 0.0], [100.0, -100.0]],
+            [[0.0, 3.0], [-100.0, 100.0]],
+        ],
+    ])
+    student = torch.tensor([
+        [
+            [[0.0, 3.0], [-100.0, 100.0]],
+            [[3.0, 0.0], [100.0, -100.0]],
+        ],
+    ], requires_grad=True)
+    mask = torch.tensor([[[True, False], [True, False]]])
+
+    kd, _ = MusicGenSolver._compute_distillation_kl(
+        solver(), student, teacher, mask)
+    kd.backward()
+
+    assert kd.item() > 0
+    assert student.grad is not None
+    assert student.grad[:, :, 0].abs().sum().item() > 0
+    assert student.grad[:, :, 1].abs().sum().item() == 0
+
+
+def test_distillation_kl_rejects_incompatible_logits():
+    student = torch.zeros(1, 2, 3, 4)
+    teacher = torch.zeros(1, 2, 3, 5)
+    mask = torch.ones(1, 2, 3, dtype=torch.bool)
+
+    with pytest.raises(ValueError, match="logit shapes"):
+        MusicGenSolver._compute_distillation_kl(
+            solver(), student, teacher, mask)
+
+
+def test_condition_tensors_are_concatenated_by_branch():
+    conditional = {
+        "description": (
+            torch.tensor([[[1.0]]]),
+            torch.tensor([[1]]),
+        ),
+    }
+    unconditional = {
+        "description": (
+            torch.tensor([[[0.0]]]),
+            torch.tensor([[0]]),
+        ),
+    }
+
+    combined = MusicGenSolver._concatenate_condition_tensors(
+        conditional, unconditional)
+
+    values, mask = combined["description"]
+    assert values[:, 0, 0].tolist() == [1.0, 0.0]
+    assert mask[:, 0].tolist() == [1, 0]

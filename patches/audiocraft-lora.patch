@@ -0,0 +1,48 @@
+from types import SimpleNamespace
+
+import torch
+
+from audiocraft.models.lm import LMModel
+from audiocraft.modules.lora import LoRAConfig
+
+
+def test_adapter_gate_is_derived_from_all_condition_masks():
+    model = SimpleNamespace(
+        lora_config=LoRAConfig.from_dict({"enabled": True, "rank": 2})
+    )
+    condition_tensors = {
+        "description": (
+            torch.zeros(3, 2, 4),
+            torch.tensor([[1, 1], [0, 0], [0, 0]]),
+        ),
+        "melody": (
+            torch.zeros(3, 1, 4),
+            torch.tensor([[0], [1], [0]]),
+        ),
+    }
+
+    gate = LMModel._adapter_gate(
+        model, condition_tensors, batch_size=3, device=torch.device("cpu"))
+
+    assert torch.equal(gate, torch.tensor([True, True, False]))
+
+
+def test_adapter_gate_can_be_independent_of_condition_masks():
+    model = SimpleNamespace(
+        lora_config=LoRAConfig.from_dict({
+            "enabled": True,
+            "rank": 2,
+            "condition_gated": False,
+        })
+    )
+    condition_tensors = {
+        "description": (
+            torch.zeros(2, 1, 4),
+            torch.zeros(2, 1),
+        ),
+    }
+
+    gate = LMModel._adapter_gate(
+        model, condition_tensors, batch_size=2, device=torch.device("cpu"))
+
+    assert torch.equal(gate, torch.tensor([True, True]))
diff --git a/tests/modules/test_lora.py b/tests/modules/test_lora.py
new file mode 100644
index 0000000..90512a2
--- /dev/null
+++ b/tests/modules/test_lora.py
@@ -0,0 +1,102 @@
+import pytest
+import torch
+
+from audiocraft.modules.lora import (
+    LoRAConfig,
+    adapter_state_dict,
+    inject_lora,
+    iter_lora_parameters,
+    load_adapter_state_dict,
+    mark_only_lora_as_trainable,
+)
+from audiocraft.modules.transformer import StreamingTransformer
+
+
+def lora_config(rank=2):
+    return {
+        "enabled": True,
+        "rank": rank,
+        "alpha": rank,
+        "dropout": 0.0,
+        "targets": ["self_attention", "cross_attention", "feedforward"],
+    }
+
+
+def test_lora_config_validation():
+    with pytest.raises(ValueError, match="rank"):
+        LoRAConfig.from_dict({"enabled": True, "rank": 0})
+    with pytest.raises(ValueError, match="targets"):
+        LoRAConfig.from_dict({"enabled": True, "targets": ["unknown"]})
+    assert LoRAConfig.from_dict({"enabled": True}).condition_gated
+    assert not LoRAConfig.from_dict({
+        "enabled": True,
+        "condition_gated": False,
+    }).condition_gated
+
+
+def test_zero_initialization_and_per_sample_null_gate():
+    torch.manual_seed(1234)
+    base = StreamingTransformer(
+        16, 4, 2, custom=True, cross_attention=True,
+        dim_feedforward=64, dropout=0.0, positional_scale=0.0)
+    adapted = StreamingTransformer(
+        16, 4, 2, custom=True, cross_attention=True,
+        dim_feedforward=64, dropout=0.0, positional_scale=0.0,
+        lora=lora_config())
+    adapted.load_state_dict(base.state_dict(), strict=False)
+    inputs = torch.randn(2, 5, 16)
+    condition = torch.randn(2, 3, 16)
+    gate = torch.tensor([True, False])
+
+    reference = base(inputs, cross_attention_src=condition)
+    initial = adapted(
+        inputs, cross_attention_src=condition, adapter_gate=gate)
+    assert torch.equal(reference, initial)
+
+    with torch.no_grad():
+        for name, parameter in adapted.named_parameters():
+            if name.endswith("lora_b"):
+                parameter.fill_(0.01)
+    output = adapted(
+        inputs, cross_attention_src=condition, adapter_gate=gate)
+    assert not torch.equal(reference[0], output[0])
+    assert torch.equal(reference[1], output[1])
+
+
+def test_rank_parameter_count_freezing_and_state_round_trip():
+    rank = 2
+    dimension = 16
+    layers = 2
+    model = StreamingTransformer(
+        dimension, 4, layers, custom=True, cross_attention=True,
+        dim_feedforward=4 * dimension, dropout=0.0, lora=lora_config(rank))
+    expected = layers * 26 * dimension * rank
+    assert sum(parameter.numel() for parameter in iter_lora_parameters(model)) == expected
+
+    trainable = mark_only_lora_as_trainable(model)
+    assert sum(parameter.numel() for parameter in trainable) == expected
+    assert all(
+        parameter.requires_grad == ("lora_" in name)
+        for name, parameter in model.named_parameters()
+    )
+
+    saved = {
+        name: value.detach().clone()
+        for name, value in adapter_state_dict(model).items()
+    }
+    clone = StreamingTransformer(
+        dimension, 4, layers, custom=True, cross_attention=True,
+        dim_feedforward=4 * dimension, dropout=0.0, lora=lora_config(rank))
+    load_adapter_state_dict(clone, saved)
+    assert all(
+        torch.equal(saved[name], value)
+        for name, value in adapter_state_dict(clone).items()
+    )
+
+
+def test_dynamic_injection():
+    model = StreamingTransformer(
+        16, 4, 1, custom=True, cross_attention=True,
+        dim_feedforward=64, dropout=0.0)
+    inject_lora(model, lora_config())
+    assert adapter_state_dict(model)

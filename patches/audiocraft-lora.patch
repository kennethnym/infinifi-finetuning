@@ -0,0 +1,195 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Low-rank adapters with per-sample conditioning gates."""
+
+from dataclasses import dataclass
+import math
+import typing as tp
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+LORA_PARAMETER_MARKER = "lora_"
+SUPPORTED_TARGETS = frozenset({
+    "self_attention",
+    "cross_attention",
+    "feedforward",
+})
+
+
+@dataclass(frozen=True)
+class LoRAConfig:
+    enabled: bool = False
+    rank: int = 8
+    alpha: float = 8.0
+    dropout: float = 0.0
+    condition_gated: bool = True
+    targets: tp.Tuple[str, ...] = tuple(sorted(SUPPORTED_TARGETS))
+
+    @classmethod
+    def from_dict(cls, config: tp.Optional[tp.Mapping[str, tp.Any]]) -> "LoRAConfig":
+        if config is None:
+            return cls()
+        targets = tuple(config.get("targets", sorted(SUPPORTED_TARGETS)))
+        value = cls(
+            enabled=bool(config.get("enabled", False)),
+            rank=int(config.get("rank", 8)),
+            alpha=float(config.get("alpha", config.get("rank", 8))),
+            dropout=float(config.get("dropout", 0.0)),
+            condition_gated=bool(config.get("condition_gated", True)),
+            targets=targets,
+        )
+        value.validate()
+        return value
+
+    def validate(self) -> None:
+        if self.rank <= 0:
+            raise ValueError("LoRA rank must be a positive integer.")
+        if not math.isfinite(self.alpha) or self.alpha <= 0:
+            raise ValueError("LoRA alpha must be a finite positive number.")
+        if not math.isfinite(self.dropout) or not 0 <= self.dropout < 1:
+            raise ValueError("LoRA dropout must be in [0, 1).")
+        unknown_targets = set(self.targets) - SUPPORTED_TARGETS
+        if unknown_targets:
+            raise ValueError(f"Unsupported LoRA targets: {sorted(unknown_targets)}")
+        if self.enabled and not self.targets:
+            raise ValueError("At least one LoRA target is required when LoRA is enabled.")
+
+    def targets_module(self, target: str) -> bool:
+        return self.enabled and target in self.targets
+
+    def to_dict(self) -> tp.Dict[str, tp.Any]:
+        return {
+            "enabled": self.enabled,
+            "rank": self.rank,
+            "alpha": self.alpha,
+            "dropout": self.dropout,
+            "condition_gated": self.condition_gated,
+            "targets": list(self.targets),
+        }
+
+
+class GatedLoRAProjection(nn.Module):
+    """A bias-free LoRA projection whose delta can be gated per batch row."""
+
+    def __init__(
+        self,
+        in_features: int,
+        out_features: int,
+        config: LoRAConfig,
+        device=None,
+        dtype=None,
+    ):
+        super().__init__()
+        if not config.enabled:
+            raise ValueError("Cannot construct a LoRA projection from a disabled config.")
+        self.in_features = in_features
+        self.out_features = out_features
+        self.rank = config.rank
+        self.alpha = config.alpha
+        self.scaling = config.alpha / config.rank
+        self.dropout = config.dropout
+        factory_kwargs = {"device": device, "dtype": dtype}
+        self.lora_a = nn.Parameter(torch.empty(config.rank, in_features, **factory_kwargs))
+        self.lora_b = nn.Parameter(torch.zeros(out_features, config.rank, **factory_kwargs))
+        nn.init.kaiming_uniform_(self.lora_a, a=math.sqrt(5))
+
+    def forward(
+        self,
+        inputs: torch.Tensor,
+        gate: tp.Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        if inputs.shape[-1] != self.in_features:
+            raise ValueError(
+                f"LoRA input dimension mismatch: expected {self.in_features}, "
+                f"got {inputs.shape[-1]}"
+            )
+        adapter_inputs = F.dropout(inputs, self.dropout, self.training)
+        delta = F.linear(F.linear(adapter_inputs, self.lora_a), self.lora_b)
+        delta = delta * self.scaling
+        if gate is not None:
+            if gate.ndim != 1 or gate.shape[0] != inputs.shape[0]:
+                raise ValueError(
+                    "LoRA gate must have shape [batch], matching the projection input."
+                )
+            gate_shape = [gate.shape[0]] + [1] * (delta.ndim - 1)
+            delta = delta * gate.to(device=delta.device, dtype=delta.dtype).view(gate_shape)
+        return delta
+
+
+def is_lora_parameter_name(name: str) -> bool:
+    return any(part.startswith(LORA_PARAMETER_MARKER) for part in name.split("."))
+
+
+def iter_lora_parameters(module: nn.Module) -> tp.Iterator[nn.Parameter]:
+    for name, parameter in module.named_parameters():
+        if is_lora_parameter_name(name):
+            yield parameter
+
+
+def mark_only_lora_as_trainable(module: nn.Module) -> tp.List[nn.Parameter]:
+    parameters = []
+    for name, parameter in module.named_parameters():
+        parameter.requires_grad_(is_lora_parameter_name(name))
+        if parameter.requires_grad:
+            parameters.append(parameter)
+    if not parameters:
+        raise RuntimeError("LoRA is enabled but the model contains no LoRA parameters.")
+    return parameters
+
+
+def adapter_state_dict(module: nn.Module) -> tp.Dict[str, torch.Tensor]:
+    return {
+        name: tensor
+        for name, tensor in module.state_dict().items()
+        if is_lora_parameter_name(name)
+    }
+
+
+def load_adapter_state_dict(
+    module: nn.Module,
+    state_dict: tp.Mapping[str, torch.Tensor],
+) -> None:
+    expected = adapter_state_dict(module)
+    missing = set(expected) - set(state_dict)
+    unexpected = set(state_dict) - set(expected)
+    if missing or unexpected:
+        raise RuntimeError(
+            "LoRA state keys do not match the model: "
+            f"missing={sorted(missing)}, unexpected={sorted(unexpected)}"
+        )
+    parameters = dict(module.named_parameters())
+    with torch.no_grad():
+        for name, source in state_dict.items():
+            destination = parameters[name]
+            if destination.shape != source.shape:
+                raise RuntimeError(
+                    f"LoRA tensor shape mismatch for {name}: "
+                    f"expected {tuple(destination.shape)}, got {tuple(source.shape)}"
+                )
+            destination.copy_(source.to(device=destination.device, dtype=destination.dtype))
+
+
+def inject_lora(module: nn.Module, config: tp.Mapping[str, tp.Any]) -> LoRAConfig:
+    resolved = LoRAConfig.from_dict(config)
+    if not resolved.enabled:
+        raise ValueError("Cannot inject a disabled LoRA configuration.")
+    injected = 0
+    compatible_modules = [
+        child for child in module.modules()
+        if getattr(child, "enable_lora", None) is not None
+    ]
+    for child in compatible_modules:
+        enable_lora = getattr(child, "enable_lora", None)
+        injected += int(enable_lora(resolved))
+    if injected == 0:
+        raise RuntimeError("No compatible transformer layers accepted the LoRA adapter.")
+    if hasattr(module, "lora_config"):
+        module.lora_config = resolved
+    return resolved

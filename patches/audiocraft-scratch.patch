+    @staticmethod
+    def _scheduled_distillation_weights(
+        initial_kl_weight: float,
+        final_kl_weight: float,
+        initial_ce_weight: float,
+        final_ce_weight: float,
+        schedule_updates: int,
+        completed_updates: int,
+    ) -> tp.Tuple[float, float]:
+        """Linearly transition CE and KD weights by optimizer update."""
+        if schedule_updates == 0:
+            return final_kl_weight, final_ce_weight
+        progress = min(max(completed_updates / schedule_updates, 0.0), 1.0)
+        kl_weight = initial_kl_weight + progress * (
+            final_kl_weight - initial_kl_weight)
+        ce_weight = initial_ce_weight + progress * (
+            final_ce_weight - initial_ce_weight)
+        return kl_weight, ce_weight
+
+    def _distillation_weights(self, batch_index: int) -> tp.Tuple[float, float]:
+        completed_updates = max(self.epoch - 1, 0) * self.train_updates_per_epoch
+        if self.is_training:
+            completed_updates += batch_index // self.gradient_accumulation_steps
+        else:
+            completed_updates += self.train_updates_per_epoch
+        cfg = self.cfg.distillation
+        return self._scheduled_distillation_weights(
+            float(cfg.initial_kl_weight),
+            float(cfg.kl_weight),
+            float(cfg.initial_ce_weight),
+            float(cfg.ce_weight),
+            int(cfg.weight_schedule_updates),
+            completed_updates,
+        )
